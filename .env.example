NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
AUTH_SECRET=replace-me
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ownerpilot
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# RFQ: use the SAME random secret (>=32 characters) on the web server and API.
RFQ_AUTH_SECRET=
RFQ_STORAGE_ROOT=.local/rfq/documents
RFQ_REDIS_URL=redis://127.0.0.1:6380/0
RFQ_OLLAMA_URL=http://localhost:11434
# Explicitly choose an installed local model from `ollama list`. Never auto-pulled.
RFQ_OLLAMA_MODEL=
RFQ_MODEL_TIMEOUT=180
RFQ_MODEL_CONTEXT=16384
RFQ_MODEL_INPUT_CHARS=12000
RFQ_MODEL_OUTPUT_TOKENS=4096
RFQ_MODEL_RETRIES=1
RFQ_MAX_FILE_BYTES=20971520
RFQ_MAX_PAGES=50

# Phase 3 local native tools; installed models only, never automatically downloaded.
PROCUREMENT_AGENT_URL=http://localhost:11434
PROCUREMENT_AGENT_MODEL=qwen3:8b
CATALOG_EMBED_URL=http://localhost:11434
CATALOG_EMBED_MODEL=nomic-embed-text:v1.5
